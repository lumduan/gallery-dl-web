# Root-level defaults for docker compose (copy to .env). Cookie values are NEVER set here —
# manage them at runtime via the Settings UI (stored only in /data/cookies.json).

# Ports published to the host
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3000

# Where downloaded media lives (an in-container path under the /data volume).
#
# To use a HOST directory instead (e.g. a NAS share), set it here AND enable the bind-mount
# overlay by uncommenting COMPOSE_FILE below — the variable alone does nothing, because the path
# still has to exist inside the container:
#   DOWNLOADS_DIR=/mnt/downloads/gallery
#   COMPOSE_FILE=docker-compose.yml:docker-compose.hostdir.yml
DOWNLOADS_DIR=/data/downloads
# COMPOSE_FILE=docker-compose.yml:docker-compose.hostdir.yml

# Comma-separated origins the backend allows via CORS (the frontend origin).
CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=INFO
MAX_CONCURRENT_JOBS=2

# Profile management
ZIP_TTL_SECONDS=300
THUMBNAIL_SIZE=300
# Auto-stop a job left paused this long (a paused worker stays suspended in memory). 0 = never.
PAUSE_MAX_SECONDS=7200

# Per-request pacing. Both platforms rate-limit scraping, but they need it in opposite shapes:
# Instagram gets ~30 posts per JSON request so a delay amortises away, while Facebook fetches one
# full HTML page PER PHOTO and pays it once per image.
#
# MIN/MAX mean different things per mode:
#   adaptive (default) — MIN is the floor and the starting delay, MAX the back-off ceiling. The
#                        run starts at MIN and only slows down when the platform pushes back
#                        (429 / 403 / block page / login redirect / gallery-dl's own warnings),
#                        then decays back. The floor also rises with the number of requests made,
#                        so a short profile stays fast while a long one gets progressively more
#                        careful — the only block ever seen came ~767 images into one run.
#   fixed              — every request sleeps a random value in [MIN, MAX] (the pre-0.5 behaviour).
# RAISE MIN if you get blocked, or switch that platform to `fixed`. Overridable per platform in
# Settings -> Download pacing (no restart), and per job from the download form.
INSTAGRAM_PACING_MODE=adaptive
FACEBOOK_PACING_MODE=adaptive
INSTAGRAM_SLEEP_REQUEST_MIN=4
INSTAGRAM_SLEEP_REQUEST_MAX=30
FACEBOOK_SLEEP_REQUEST_MIN=1
FACEBOOK_SLEEP_REQUEST_MAX=30

# Per-IMAGE pacing, a different axis that applies in BOTH modes. Everything above spaces the
# extractor's API requests; one Instagram request returns ~30 posts whose images then download back
# to back with nothing between them. Measured runs showed a 0.8-2.7 s median gap between
# consecutive files while the API calls sat 20 s apart, and it is that burst, not the run's
# average, that a rate limiter reacts to.
#
# The value is the MEAN gap: it is emitted to gallery-dl as a +/-15% band so the gaps are not
# perfectly periodic. 0 disables it entirely. Charged only on files actually downloaded, so
# re-running a profile you already have costs nothing extra.
#
# Facebook is 0 on purpose: it fetches a full page per photo, so it already pays the request delay
# once per image and this would double-charge it.
INSTAGRAM_SLEEP_FILE=2
FACEBOOK_SLEEP_FILE=0

# Stall detection + retry. Two independent deadlines, see docs/event-contract.md:
#   liveness — no worker output at all (not even a heartbeat) => the process is wedged
#   progress — no *file* event. Before the first file this is the WARM-UP budget, because
#              gallery-dl is silent while enumerating a profile. After the first file:
#              clamp(floor*backoff^attempt, multiplier*avg_inter_file, cap)
HTTP_TIMEOUT_SECONDS=30
HEARTBEAT_SECONDS=15
STALL_LIVENESS_SECONDS=60
STALL_WARMUP_SECONDS=600
STALL_WARMUP_MAX_RETRIES=1
STALL_FLOOR_SECONDS=300
STALL_MULTIPLIER=4
STALL_CAP_SECONDS=600
STALL_MAX_RETRIES=2
STALL_BACKOFF=1.5
STALL_KILL_GRACE_SECONDS=10
