# Copy to .env and adjust. Cookies are NEVER set here — manage them via the Settings UI
# (stored only in /data/cookies.json, mode 0600, gitignored).

APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

DATA_DIR=/data
DOWNLOADS_DIR=/data/downloads
COOKIES_PATH=/data/cookies.json

# Comma-separated origins allowed by CORS (the Next.js frontend).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

MAX_CONCURRENT_JOBS=2

# Profile management: seconds a generated profile .zip lives after last access; thumbnail longest-side px.
ZIP_TTL_SECONDS=300
THUMBNAIL_SIZE=300
# Auto-stop a job left paused this long (a paused worker stays suspended in memory). 0 = never.
PAUSE_MAX_SECONDS=7200

# Per-request pacing. See the root .env.example for the full explanation; in short, MIN/MAX are a
# floor and a back-off ceiling in `adaptive` mode, and a random range in `fixed` mode.
INSTAGRAM_PACING_MODE=adaptive
FACEBOOK_PACING_MODE=adaptive
INSTAGRAM_SLEEP_REQUEST_MIN=4
INSTAGRAM_SLEEP_REQUEST_MAX=30
FACEBOOK_SLEEP_REQUEST_MIN=1
FACEBOOK_SLEEP_REQUEST_MAX=30

# Per-IMAGE pacing (both modes): mean seconds between individual image downloads, emitted as a
# +/-15% band. 0 disables it. See the root .env.example for why Facebook is 0.
INSTAGRAM_SLEEP_FILE=2
FACEBOOK_SLEEP_FILE=0

# Stall detection + retry. Two independent deadlines (see docs/event-contract.md):
#   liveness — no worker output at all, not even a heartbeat => the process is wedged.
#   progress — no prepare/file event. Before the first file that is the WARM-UP budget; after it,
#              clamp(floor*backoff^attempt, multiplier*avg_inter_file, cap).
HTTP_TIMEOUT_SECONDS=30
HEARTBEAT_SECONDS=15
STALL_LIVENESS_SECONDS=60
STALL_WARMUP_SECONDS=600
STALL_WARMUP_MAX_RETRIES=1
STALL_FLOOR_SECONDS=300
STALL_MULTIPLIER=4
STALL_CAP_SECONDS=600
STALL_MAX_RETRIES=2
STALL_BACKOFF=1.5
STALL_KILL_GRACE_SECONDS=10
